# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# SalamDesk Worker image
#
# Three-stage build:
#   deps    — full npm ci (all deps, needed to compile)
#   builder — tsup compiles TypeScript → ESM JS, resolves @/* aliases
#   runtime — production deps only + compiled output; no tsx, no typescript,
#             no Next.js build tooling → ~40% smaller image than the old approach
#
# The Next.js web app deploys separately to Vercel and is NOT built here.
# ---------------------------------------------------------------------------

# Debian slim (not alpine) — avoids musl issues with Baileys / liteparse / native deps.
FROM node:22-slim AS deps

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# ---------------------------------------------------------------------------
FROM node:22-slim AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules

# Files needed for compilation
COPY package.json tsconfig.json tsconfig.worker.json tsup.worker.config.ts auth-schema.ts ./
COPY src ./src

RUN npm run build:worker

# ---------------------------------------------------------------------------
FROM node:22-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./

# Skip devDependencies (tsx, typescript, drizzle-kit, eslint, tailwind, tsup…).
# The compiled dist-worker/ bundle has no path-alias imports — all @/* resolved
# at build time — so only production runtime deps are needed here.
RUN npm ci --omit=dev

# The lockfile is generated on Windows, so it carries a real entry only for
# sharp's win32 binary. Pull the linux-x64 binary explicitly for the container.
RUN npm install --no-save "@img/sharp-linux-x64@$(node -p "require('sharp/package.json').version")"

# Compiled worker bundle (all source inlined, deps remain external imports)
COPY --from=builder /app/dist-worker ./dist-worker

# Persistent WhatsApp auth lives here (mounted as a volume — see compose file).
RUN mkdir -p /app/wa_auth /app/tmp

CMD ["node", "dist-worker/index.js"]
