# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# SalamDesk Worker image
#
# Runs the long-lived background process (Baileys WhatsApp socket + BullMQ
# workers + repeat jobs + wa-control subscriber). This is the half of the app
# that CANNOT run on Vercel — it needs an always-on process and a persistent
# disk for the WhatsApp auth state (./wa_auth).
#
# The Next.js web app deploys separately to Vercel and is NOT built here.
# ---------------------------------------------------------------------------

# Debian slim (not alpine) — avoids musl issues with Baileys / liteparse / native deps.
FROM node:22-slim AS deps

WORKDIR /app

# Install dependencies (incl. devDependencies — the worker runs via `tsx`,
# which lives in devDependencies). Use the lockfile for reproducible installs.
COPY package.json package-lock.json ./
RUN npm ci

# The lockfile is generated on Windows during dev, so it carries a real entry
# only for sharp's win32 binary — the linux-x64 package is referenced but not
# resolved, and `npm ci` silently skips it. The worker then crashes at runtime
# ("Could not load the sharp module using the linux-x64 runtime"). Pull the
# matching linux-x64 binary explicitly (it brings its libvips dep with it).
RUN npm install --no-save "@img/sharp-linux-x64@$(node -p "require('sharp/package.json').version")"

# ---------------------------------------------------------------------------
FROM node:22-slim AS runtime

ENV NODE_ENV=production
# Workers don't need Next telemetry / build steps.
WORKDIR /app

# Reuse the resolved node_modules from the deps stage.
COPY --from=deps /app/node_modules ./node_modules

# Copy only what the worker process needs at runtime.
COPY package.json package-lock.json tsconfig.json ./
# Better Auth's generated table schema lives at the repo root and is imported
# by src/db/schema/index.ts (as ../../../auth-schema) — must ship in the image.
COPY auth-schema.ts ./
COPY src ./src

# Persistent WhatsApp auth lives here (mounted as a volume — see compose file).
# Pre-create so the dir exists even before the first creds.update.
RUN mkdir -p /app/wa_auth /app/tmp

# tsx resolves the "@/*" path alias from tsconfig.json automatically.
CMD ["npx", "tsx", "src/worker/index.ts"]
