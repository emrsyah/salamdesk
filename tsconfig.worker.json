{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/worker/**/*",
    "src/lib/**/*",
    "src/db/**/*",
    "src/services/**/*",
    "auth-schema.ts"
  ],
  "exclude": [
    "node_modules",
    "src/app/**/*",
    "src/components/**/*",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/lib/notification-sound.ts",
    "src/lib/tickets/ticket-configuration-storage.ts"
  ]
}
