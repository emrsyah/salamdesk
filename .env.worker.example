# ---------------------------------------------------------------------------
# SalamDesk Worker env — copy to `.env.worker` on the VPS and fill in.
#   cp .env.worker.example .env.worker
#
# KNOWLEDGE_INGESTION_TMP_DIR is set by docker-compose, so you don't need it
# here unless running the worker outside compose.
# ---------------------------------------------------------------------------

# Managed Postgres (Neon / Supabase). Must be the SAME DB the Vercel app uses.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Managed Redis — Upstash TCP endpoint. Must be the SAME Redis the Vercel app
# uses. Use the rediss:// (TLS) connection string from the Upstash console,
# NOT the REST URL — BullMQ needs a real TCP connection with blocking commands.
REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# AI triage (OpenRouter via the Vercel AI SDK)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Used by the AI layer as a base URL reference — set to your Vercel app URL.
BETTER_AUTH_URL=https://your-app.vercel.app

# Knowledge-base embeddings (Voyage AI)
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=

# File uploads (only if the knowledge-ingestion worker downloads from UploadThing)
UPLOADTHING_TOKEN=

# Logging → Axiom (read by the Vector sidecar in docker-compose.worker.yml,
# which tails this container's stdout and forwards to Axiom). Use the SAME
# dataset as the Vercel app so web + worker logs pool together.
AXIOM_TOKEN=
AXIOM_DATASET=salamdesk
