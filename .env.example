# Database
# Required by the app, worker, Drizzle migrations, and seed scripts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Auth
# Generate a strong secret for Better Auth.
BETTER_AUTH_SECRET="replace-with-a-random-secret"
BETTER_AUTH_URL="http://localhost:6767"

# Redis / BullMQ
# Used by queues, background workers, and WhatsApp control events.
REDIS_URL="redis://localhost:6379"

# AI triage via OpenRouter
OPENROUTER_API_KEY="replace-with-openrouter-api-key"
OPENROUTER_MODEL="google/gemini-2.0-flash"

# UploadThing
# Required for knowledge document uploads.
UPLOADTHING_TOKEN="replace-with-uploadthing-token"

# Knowledge embeddings via Voyage AI
# Required when ingesting or semantically searching knowledge documents.
VOYAGE_API_KEY="replace-with-voyage-api-key"
VOYAGE_EMBEDDING_MODEL="voyage-4"

# Knowledge ingestion
# Optional. Defaults to the OS temp directory under "salamdesk-knowledge-ingestion".
KNOWLEDGE_INGESTION_TMP_DIR=""

# 64 hex chars; generate: openssl rand -hex 32
AGENT_SECRET_KEY=

# Exa web search (https://exa.ai)
EXA_API_KEY=

# Logging → Axiom (web side, @axiomhq/nextjs). Hobby plan can't use Vercel log
# drains, so the app ships logs directly via the Axiom API. Use the SAME dataset
# name as the worker so web + worker logs pool together (filter by `service`).
# Set these in the Vercel project env, not just locally.
AXIOM_TOKEN=
AXIOM_DATASET=salamdesk
